+# Consequential motion, not a timer or UI action, owns this machine's sound.
+func update_macro_bridge(speed: float, tension: float, nose: Vector3) -> void:
+	var moving := absf(speed) > 0.03 and tension > 100.0
+	if moving:
+		macro_motion_frames += 1
+	if nose.y < 10.65:
+		_macro_seated_sound = false
+	if nose.y > 10.70 and absf(speed) < 0.03 and not _macro_seated_sound:
+		_macro_seated_sound = true
+		macro_stop_cues += 1
+		_play_at(&"clang", nose, -5.0, 0.7, BUS_EFFECTS)
+	if not _bank_ready or _silent:
+		return
+	var gain := clampf(absf(speed) / 1.3, 0.0, 1.0) if moving else 0.0
+	_macro_drive.volume_db = linear_to_db(maxf(gain, 0.0001)) - 5.0
+	_macro_drive.pitch_scale = lerpf(0.65, 0.92, gain)
+
