{
  "mcpServers": {
    "godot": {
      "type": "stdio",
      "command": "bash",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/.claude/godot-mcp.sh"]
    },
    "godot-docs": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/mcintalmo/godot-docs-mcp@db284cc2ddab9c486ec6430297215f92fa288ef4", "godot-docs-mcp"],
      "env": { "GODOT_DOCS_MCP_GODOT_VERSION": "4.7" }
    }
  }
}
