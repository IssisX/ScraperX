{
  "enabledMcpjsonServers": [
    "godot"
  ],
  "env": {
    "MCP_TOOL_TIMEOUT": "300000"
  },
  "permissions": {
    "allow": [
      "mcp__godot",
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Workflow",
      "Skill",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskStop",
      "ToolSearch",
      "Artifact",
      "Monitor",
      "ReadNotifications",
      "SendMessage",
      "ListAgents",
      "SendUserFile",
      "PushNotification",
      "ScheduleWakeup",
      "mcp__github",
      "mcp__Claude_Code_Remote",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__get_session",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__read_documentation",
      "mcp__claude-code-remote",
      "mcp__Hugging_Face",
      "mcp__Claude_Docs",
      "ArtifactComments",
      "ArtifactData",
      "CronCreate",
      "CronList",
      "CronDelete",
      "EnterWorktree",
      "ExitWorktree",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "SearchMcpRegistry",
      "ListConnectors",
      "ListSkills",
      "SearchSkills",
      "ListPlugins",
      "SearchPlugins",
      "DesignSync",
      "TaskOutput"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
