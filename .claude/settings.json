{
  "enabledMcpjsonServers": ["godot"],
  "env": {
    "MCP_TOOL_TIMEOUT": "300000"
  },
  "permissions": {
    "allow": ["mcp__godot"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
