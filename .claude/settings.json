{
  "enabledMcpjsonServers": [
    "godot",
    "godot-docs",
    "deepwiki"
  ],
  "env": {
    "MCP_TOOL_TIMEOUT": "300000"
  },
  "permissions": {
    "allow": [
      "mcp__godot",
      "mcp__godot-docs",
      "mcp__deepwiki",
      "Bash",
      "Bash(npx --yes skills@1.7.4 find *)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Workflow",
      "Skill",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskStop",
      "ToolSearch",
      "Artifact",
      "Monitor",
      "ReadNotifications",
      "SendMessage",
      "ListAgents",
      "SendUserFile",
      "PushNotification",
      "ScheduleWakeup",
      "mcp__github",
      "mcp__Claude_Code_Remote",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__get_session",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__read_documentation",
      "mcp__claude-code-remote",
      "mcp__Hugging_Face",
      "mcp__Claude_Docs",
      "ArtifactComments",
      "ArtifactData",
      "CronCreate",
      "CronList",
      "CronDelete",
      "EnterWorktree",
      "ExitWorktree",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "SearchMcpRegistry",
      "ListConnectors",
      "ListSkills",
      "SearchSkills",
      "ListPlugins",
      "SearchPlugins",
      "DesignSync",
      "TaskOutput"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push * :refs/heads/main*)",
      "Bash(git push * --delete *)",
      "Bash(git branch -D *)",
      "Bash(rm -rf /*)",
      "mcp__github__merge_pull_request",
      "mcp__github__delete_file",
      "mcp__github__create_repository",
      "mcp__github__fork_repository"
    ],
    "additionalDirectories": [
      "/tmp/claude-0"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
