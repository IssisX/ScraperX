var _north_probe_active := false
var _north_probe_failure := ""
var _north_probe_tick := 0
var _north_probe_command := 0.0
var _north_probe_positive := 0.0
var _north_probe_samples := 0
var _north_probe_loaded := false
var _north_probe_two_hands := false
var _north_probe_peak := 0.0
var _north_probe_transfer_before_tick := -1
var _north_probe_transfer_observed_tick := -1

func _north_probe_state() -> String:
	return "tick=%d at=%s velocity=%s support=%d grounded=%s crouched=%s traversal=%d accepted=%d deaths=%d target=%s grip=%s ledge=%s left_hand=%s right_hand=%s native=%s" % [
		_native().get_tick_index(), _position(), _velocity(), _native().get_support_entity_id(),
		_native().is_player_grounded(), _native().is_player_crouched(), _native().get_traversal_state(),
		_native().get_accepted_traversal_count(), _native().get_death_count(), _native().get_traversal_target_point(),
		_native().get_grip_point(), _native().get_ledge_point(), _native().get_traversal_left_hand(),
		_native().get_traversal_right_hand(), _native().get_landing_state()]

func _process(_delta: float) -> void:
	if not _north_probe_active:
		return
	var state: Dictionary = _native().get_landing_state()
	var tick := int(_native().get_tick_index())
	var left: Vector3 = state["left_hand_force_n"]
	var right: Vector3 = state["right_hand_force_n"]
	var command := float(state["traversal_command_work_bound_j"])
	var positive := float(state["hand_actuator_positive_work_j"])
	var budget := 6600.0 * float(tick - _north_probe_tick) / 90.0 + 0.001
	var traversal := int(_native().get_traversal_state())
	if traversal == _main.TRAVERSAL_CLIMBING and _north_probe_transfer_before_tick < 0 \
			and (_native().get_traversal_target_point() as Vector3).y > 94.7:
		_north_probe_transfer_before_tick = _north_probe_tick
		_north_probe_transfer_observed_tick = tick
		print("SCRAPERX_NORTH_FIRST_TOUCH transfer_first_observed " + _north_probe_state())
	if traversal == _main.TRAVERSAL_CLIMBING and tick / 90 != _north_probe_tick / 90:
		print("SCRAPERX_NORTH_FIRST_TOUCH climb_sample " + _north_probe_state())
	var invalid := int(_native().get_death_count()) != 0 or float(state["player_gravity_factor"]) != 1.0 \
		or not _position().is_finite() or not _velocity().is_finite() or not left.is_finite() or not right.is_finite() \
		or left.length() > 1501.0 or right.length() > 1501.0 \
		or traversal in [_main.TRAVERSAL_MANTLING, _main.TRAVERSAL_VAULTING] \
		or bool(_native().is_parachute_deployed()) or not is_finite(command) or not is_finite(positive) \
		or command - _north_probe_command < -0.000001 or positive - _north_probe_positive < -0.000001 \
		or command - _north_probe_command > budget or positive - _north_probe_positive > budget
	if traversal == _main.TRAVERSAL_CLIMBING:
		invalid = invalid or int(state["traversal_hand_constraint_count"]) != 2 \
			or int(_native().get_traversal_support_entity_id()) != 1901
		_north_probe_two_hands = true
	_north_probe_peak = maxf(_north_probe_peak, (left + right).length())
	_north_probe_loaded = _north_probe_loaded or left.length() > 0.01 or right.length() > 0.01
	_north_probe_command = command
	_north_probe_positive = positive
	_north_probe_tick = tick
	_north_probe_samples += 1
	if invalid:
		_north_probe_failure = "native gravity/hand/work/traversal invariant " + _north_probe_state()
		_north_probe_active = false
		_move(InputRouter.Device.TOUCH, 0.0)
		print("SCRAPERX_NORTH_FIRST_TOUCH FAIL " + _north_probe_failure)
		get_tree().quit(31)

func _north_probe_roof() -> bool:
	var state: Dictionary = _native().get_landing_state()
	return _native().is_player_grounded() and not _native().is_player_crouched() \
		and int(_native().get_support_entity_id()) == 1901 and int(_native().get_traversal_state()) == 0 \
		and int(state["traversal_hand_constraint_count"]) == 0 and float(state["player_gravity_factor"]) == 1.0 \
		and absf(_position().y - 94.9) < 0.12 and absf(_velocity().y) < 0.12 \
		and Vector2(_velocity().x, _velocity().z).length() < 0.18 and int(_native().get_death_count()) == 0

func _north_probe_hold(ticks: int) -> bool:
	_move(InputRouter.Device.TOUCH, 0.0)
	if not await _wait_until(_north_probe_roof, 3.0):
		return _fail("first roof did not settle " + _north_probe_state())
	var start := int(_native().get_tick_index())
	while int(_native().get_tick_index()) - start < ticks:
		await get_tree().process_frame
		if not _north_probe_roof() or not _north_probe_failure.is_empty():
			return _fail("firm roof lost during hold " + _north_probe_state())
	return true

func _touch_north_grip_diagnostic() -> bool:
	# One supported stage only; every subsequent move/action reaches native
	# through the existing viewport-touch driver and shipping Main dispatcher.
	if not _campaign_world_intact() or int(_native().get_entity_body_count(1901)) != 1:
		return _fail("first-ladder proof is not the normal shipping world")
	if not _native().debug_restart_at(Vector3(16.00084, 88.9, -179.4486)):
		return _fail("first-ladder supported staging rejected")
	var state: Dictionary = _native().get_landing_state()
	_north_probe_tick = int(_native().get_tick_index())
	_north_probe_command = float(state["traversal_command_work_bound_j"])
	_north_probe_positive = float(state["hand_actuator_positive_work_j"])
	_north_probe_active = true
	await _face(Vector2(0, -1))
	await _seconds(0.5)
	if not _native().is_player_grounded() or int(_native().get_support_entity_id()) != 1901 \
			or absf(_position().y - 88.9) > 0.12:
		return _fail("initial stage did not establish real88m support " + _north_probe_state())
	if not await _walk_to(InputRouter.Device.TOUCH, Vector2(16, -179.55), 0.04, 2.0):
		return _fail("ordinary first-ladder stance unavailable " + _north_probe_state())
	await _seconds(0.5)
	if not _native().is_grip_available() or not await _offered(&"climb", "CLIMB", "HOLD"):
		return _fail("real first-ladder grip not offered " + _north_probe_state())
	state = _native().get_landing_state()
	var count := int(state["foot_transfer_count"])
	var accepted := int(_native().get_accepted_traversal_count())
	var start_tick := int(_native().get_tick_index())
	print("SCRAPERX_NORTH_FIRST_TOUCH entry " + _north_probe_state())
	if not await _north_climb(InputRouter.Device.TOUCH, 94.7, "physical first north climb"):
		return _fail("first-ladder climb failed " + _north_probe_state())
	state = _native().get_landing_state()
	if int(state["foot_transfer_count"]) != count + 1 or int(state["foot_transfer_support_entity_id"]) != 1901 \
			or int(state["foot_transfer_tick"]) <= start_tick or float(state["foot_transfer_peak_hand_load_n"]) <= 0.0 \
			or int(_native().get_accepted_traversal_count()) != accepted + 1 \
			or not _north_probe_loaded or not _north_probe_two_hands or not _north_probe_failure.is_empty():
		return _fail("first roof lacks physical hand-to-foot receipt " + _north_probe_state())
	var receipt_tick := int(state["foot_transfer_tick"])
	var transfer_upper_seconds := float(receipt_tick - _north_probe_transfer_before_tick) / 90.0
	if _north_probe_transfer_before_tick < 0 or transfer_upper_seconds > 1.7:
		return _fail("native transfer timing upper_s=%.6f before_target_tick=%d first_target_tick=%d receipt_tick=%d %s" % [
			transfer_upper_seconds, _north_probe_transfer_before_tick, _north_probe_transfer_observed_tick, receipt_tick, _north_probe_state()])
	if not await _north_probe_hold(270):
		return false
	var roof := _position()
	for point in [Vector2(16, -181.2), Vector2(14, -181.2)]:
		if not await _walk_to(InputRouter.Device.TOUCH, point, 0.14, 9.0, true):
			return _fail("ordinary first-roof onward target=%s %s" % [point, _north_probe_state()])
	if not await _north_probe_hold(90) or _position().distance_to(roof) < 1.5 \
			or not _campaign_world_intact() or _main._router.device != InputRouter.Device.TOUCH:
		return _fail("first roof onward closure lacks firm real support " + _north_probe_state())
	print("SCRAPERX_NORTH_FIRST_TOUCH exit " + _north_probe_state())
	_north_probe_active = false
	_detail = "staging=supported_recorded88m continuous_ascent=0 first_ladder88_to94=1 viewport_touch=1 gravity=1 legacy_mantle=0 physical_two_hands=1 foot_transfer=1 firm_roof_ticks=270 onward_m=%.3f onward_hold_ticks=90 support=1901 deaths=0 samples=%d peak_hand_load_n=%.3f transfer_upper_s=%.6f command_work_j=%.3f positive_work_j=%.3f" % [
		_position().distance_to(roof), _north_probe_samples, _north_probe_peak, transfer_upper_seconds, _north_probe_command, _north_probe_positive]
	return true
