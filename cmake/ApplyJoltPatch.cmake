# Apply the bounded extension without resetting or overwriting unknown work.
# Both pristine and already-patched pinned sources have exact hash receipts.
foreach(required JOLT_SOURCE JOLT_PATCH JOLT_PATCH_MANIFEST GIT_EXECUTABLE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required} for the pinned Jolt attachment patch")
    endif()
endforeach()
include("${JOLT_PATCH_MANIFEST}")
list(LENGTH SCRAPERX_JOLT_ATTACHMENT_FILES file_count)
list(LENGTH SCRAPERX_JOLT_ATTACHMENT_ORIGINAL_SHA256 original_count)
list(LENGTH SCRAPERX_JOLT_ATTACHMENT_PATCHED_SHA256 patched_count)
if(file_count EQUAL 0 OR NOT file_count EQUAL original_count OR NOT file_count EQUAL patched_count)
    message(FATAL_ERROR "Invalid pinned Jolt attachment hash manifest")
endif()
math(EXPR last_file "${file_count} - 1")
set(pristine 0)
set(patched 0)
foreach(index RANGE 0 ${last_file})
    list(GET SCRAPERX_JOLT_ATTACHMENT_FILES ${index} relative_path)
    list(GET SCRAPERX_JOLT_ATTACHMENT_ORIGINAL_SHA256 ${index} original_hash)
    list(GET SCRAPERX_JOLT_ATTACHMENT_PATCHED_SHA256 ${index} patched_hash)
    file(SHA256 "${JOLT_SOURCE}/${relative_path}" actual_hash)
    if("${actual_hash}" STREQUAL "${original_hash}")
        math(EXPR pristine "${pristine} + 1")
    elseif("${actual_hash}" STREQUAL "${patched_hash}")
        math(EXPR patched "${patched} + 1")
    else()
        message(FATAL_ERROR "Unexpected Jolt source ${relative_path}; preserve it and inspect before applying the attachment patch")
    endif()
endforeach()
if(patched EQUAL file_count)
    message(STATUS "Pinned Jolt attachment patch already verified")
    return()
endif()
if(NOT pristine EQUAL file_count)
    message(FATAL_ERROR "Partially patched Jolt source; preserve it and inspect")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${JOLT_PATCH}"
    WORKING_DIRECTORY "${JOLT_SOURCE}" RESULT_VARIABLE check_result ERROR_VARIABLE patch_error)
if(NOT check_result EQUAL 0)
    message(FATAL_ERROR "Pinned Jolt attachment patch check failed: ${patch_error}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${JOLT_PATCH}"
    WORKING_DIRECTORY "${JOLT_SOURCE}" RESULT_VARIABLE apply_result ERROR_VARIABLE patch_error)
if(NOT apply_result EQUAL 0)
    message(FATAL_ERROR "Pinned Jolt attachment patch failed: ${patch_error}")
endif()
foreach(index RANGE 0 ${last_file})
    list(GET SCRAPERX_JOLT_ATTACHMENT_FILES ${index} relative_path)
    list(GET SCRAPERX_JOLT_ATTACHMENT_PATCHED_SHA256 ${index} patched_hash)
    file(SHA256 "${JOLT_SOURCE}/${relative_path}" actual_hash)
    if(NOT "${actual_hash}" STREQUAL "${patched_hash}")
        message(FATAL_ERROR "Patched Jolt source hash mismatch: ${relative_path}")
    endif()
endforeach()
message(STATUS "Pinned Jolt attachment patch applied and verified")
