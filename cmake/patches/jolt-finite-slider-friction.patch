+void SliderConstraint::SetupFiniteFrictionPositionCorrection(float inDeltaTime)
+{
+	mFrictionPositionValid = false;
+	mFrictionPositionBudget = 0.0f;
+	mFrictionPositionLambda = 0.0f;
+	if (!mUseFiniteFrictionPositionCorrection || mMotorState != EMotorState::Off || mMaxFrictionForce <= 0.0f || !mMotorConstraintPart.IsActive())
+		return;
+	// Consume the unused physical impulse budget once, never once per iteration.
+	// Match the rounded physical-row cap; keep subtraction in a separate full expression to avoid FMA granting budget at saturation.
+	// Force a float round-trip even under the x86 -ffp-contract=fast policy.
+	// This controls precision, not synchronization: match the physical clamp.
+	const volatile float max_lambda = mMaxFrictionForce * inDeltaTime;
+	mFrictionPositionBudget = max(0.0f, max_lambda - abs(mMotorConstraintPart.GetTotalLambda())) * inDeltaTime;
+	mFrictionPositionTarget = GetCurrentPosition();
+	if (mHasLimits && !mLimitsSpringSettings.HasStiffness())
+		mFrictionPositionTarget = Clamp(mFrictionPositionTarget, mLimitsMin, mLimitsMax);
+	mFrictionPositionValid = mFrictionPositionBudget > 0.0f;
+}
+
+bool SliderConstraint::SolveFiniteFrictionPositionCorrection(float inBaumgarte)
+{
+	if (!mFrictionPositionValid)
+		return false;
+	Mat44 rotation1 = Mat44::sRotation(mBody1->GetRotation());
+	Mat44 rotation2 = Mat44::sRotation(mBody2->GetRotation());
+	CalculateR1R2U(rotation1, rotation2);
+	CalculateSlidingAxisAndPosition(rotation1);
+	// Use a fresh native row without touching the velocity motor's warm-start cache.
+	AxisConstraintPart row;
+	row.CalculateConstraintProperties(*mBody1, mR1 + mU, *mBody2, mR2, mWorldSpaceSliderAxis);
+	return row.SolvePositionConstraintWithLimits(*mBody1, *mBody2, mWorldSpaceSliderAxis,
+		mD - mFrictionPositionTarget, inBaumgarte, -mFrictionPositionBudget, mFrictionPositionBudget, mFrictionPositionLambda);
 }
 
