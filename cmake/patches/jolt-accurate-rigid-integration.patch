+void Body::AddPositionStep(Vec3Arg inLinearVelocityTimesDeltaTime)
+{
+	JPH_ASSERT(IsRigidBody());
+	JPH_ASSERT(BodyAccess::sCheckRights(BodyAccess::sPositionAccess(), BodyAccess::EAccess::ReadWrite));
+	if (mMotionProperties->mUseAccurateIntegration)
+	{
+		// Error feedback: retain only the part lost when rounding the world position.
+		Vec3 delta = mMotionProperties->LockTranslation(inLinearVelocityTimesDeltaTime + mMotionProperties->mPositionIntegrationResidual);
+		RVec3 previous = mPosition;
+		mPosition += delta;
+		mMotionProperties->mPositionIntegrationResidual = delta - Vec3(mPosition - previous);
+	}
+	else
+		mPosition += mMotionProperties->LockTranslation(inLinearVelocityTimesDeltaTime);
+	JPH_ASSERT(!mPosition.IsNaN());
+}
+
+void Body::SubPositionStep(Vec3Arg inLinearVelocityTimesDeltaTime)
+{
+	JPH_ASSERT(IsRigidBody());
+	JPH_ASSERT(BodyAccess::sCheckRights(BodyAccess::sPositionAccess(), BodyAccess::EAccess::ReadWrite));
+	if (mMotionProperties->mUseAccurateIntegration)
+		AddPositionStep(-inLinearVelocityTimesDeltaTime);
+	else
+		mPosition -= mMotionProperties->LockTranslation(inLinearVelocityTimesDeltaTime);
+	JPH_ASSERT(!mPosition.IsNaN());
+}
