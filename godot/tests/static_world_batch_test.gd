extends SceneTree

const Batch := preload("res://presentation/static_world_batch.gd")
const Geometry := preload("res://presentation/world_geometry.gd")
const Export := preload("res://presentation/solid_export.gd")
var _failures := 0


func _initialize() -> void:
	call_deferred("_run")


func _check(condition: bool, label: String) -> void:
	if not condition:
		_failures += 1
		push_error(label)


func _run() -> void:
	var host := Node3D.new()
	root.add_child(host)
	var geometry := Geometry.new(host)
	var finish := geometry.material(Color("687174"), 0.35, 0.78)
	var first := geometry.add_box("ButtressFoot", Vector3(2, 3, 4), Vector3(2, 4, 6), finish)
	var second := geometry.add_box("ButtressFoot", Vector3(4, 2, 1), Vector3(8, 4, 3), finish)
	second.rotation.y = 0.4
	second.scale = Vector3(1.0, 1.5, 0.8)
	var distant := geometry.add_box("ButtressFoot", Vector3.ONE, Vector3(2, 92, 6), finish)
	var moving := geometry.add_box("LiftPlatform", Vector3.ONE, Vector3(2, 4, 6), finish)
	var transparent := finish.duplicate() as StandardMaterial3D
	transparent.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	var glass := geometry.add_box("YardLens", Vector3.ONE, Vector3(2, 4, 6), transparent)
	var shader := ShaderMaterial.new()
	shader.shader = load("res://presentation/yard_cloth.gdshader")
	var cloth := geometry.add_box("YardPennant", Vector3.ONE, Vector3(2, 4, 6), shader)
	var before := Export.collect(host)
	_check(before.boxes.size() == 3, "collision comparison includes three real exported solids")
	var expected := _vertices([first, second])
	var batch := Batch.new()
	var result := batch.build_tower(host)
	_check(result.replaced_sources == 2 and result.batches == 1, "compatible local opaque parts share exactly one batch")
	_check(first.layers == 0 and second.layers == 0, "no duplicate source submissions")
	_check(first.mesh != null and first.has_meta(&"part"), "authored collision/inspection source retained")
	_check(distant.layers != 0, "separate height cell remains independently culled")
	_check(moving.layers != 0 and glass.layers != 0 and cloth.layers != 0, "moving/translucent/shader sources retain render authority")
	var after := Export.collect(host)
	_check(before == after, "runtime batching cannot change any exported collision entry")
	var merged := host.get_child(host.get_child_count() - 1) as MeshInstance3D
	_check(merged != null and merged.mesh != null, "merged batch exists")
	if merged != null:
		var actual := _vertices([merged])
		_check(_same_vertices(expected, actual), "every transformed triangle and UV remains present exactly once")
		_check(merged.cast_shadow == first.cast_shadow, "shadow mode retained")
	# Repeated sibling names are not stable identifiers in the scene tree.
	var foliage_host := Node3D.new()
	root.add_child(foliage_host)
	for i in 3:
		var tree := Node3D.new()
		tree.name = "Conifer"
		foliage_host.add_child(tree)
		geometry.add_box_to("TreeCanopy", Vector3.ONE, Vector3(i, 2, 0), finish, tree)
	var foliage_result := batch.build_tower(foliage_host)
	_check(foliage_result.replaced_sources == 3, "all repeated/autogenerated foliage containers enter batching")
	var local_host := Node3D.new()
	root.add_child(local_host)
	var local_geometry := Geometry.new(local_host)
	var projected := local_geometry.material(Color.WHITE, 0.0, 0.5)
	projected.uv1_triplanar = true
	var local_sources: Array[MeshInstance3D] = []
	for i in 3:
		var source := local_geometry.add_box("ParkourStructure", Vector3(2, 3, 4), Vector3(i * 3, 3, 2), projected)
		source.rotation.y = float(i) * 0.3
		local_sources.append(source)
	var local_result := batch.build_tower(local_host)
	_check(local_result.replaced_sources == 3, "identical local-projected geometry batches")
	var instances := local_host.get_child(local_host.get_child_count() - 1) as MultiMeshInstance3D
	_check(instances != null, "local triplanar material uses instancing to preserve texture coordinates")
	if instances != null:
		_check(instances.multimesh.mesh == local_sources[0].mesh, "original local vertices/UV/tangents retained")
		for i in 3:
			var actual := instances.global_transform * instances.multimesh.get_instance_transform(i)
			_check(actual.is_equal_approx(local_sources[i].global_transform), "original instance pose %d retained" % i)
	var forest := Node3D.new()
	root.add_child(forest)
	var forest_geometry := Geometry.new(forest)
	var canopies: Array[MeshInstance3D] = []
	for i in 3:
		var tree := Node3D.new()
		forest.add_child(tree)
		var color := Color(0.14 + float(i) * 0.02, 0.28, 0.14, 1)
		canopies.append(forest_geometry.add_cone("TreeCanopy", 1.0 + float(i), 2.0 + float(i),
			Vector3(i * 4, 3, 0), forest_geometry.material(color, 0.0, 0.92), tree))
	var forest_result := batch.build_tower(forest)
	_check(forest_result.replaced_sources == 3 and forest_result.batches == 1, "varied foliage dimensions/tints use one instanced batch")
	var forest_batch := forest.get_child(forest.get_child_count() - 1) as MultiMeshInstance3D
	if forest_batch != null:
		for i in 3:
			var original_color: Color = canopies[i].get_active_material(0).albedo_color
			var actual_color := forest_batch.multimesh.get_instance_color(i)
			_check(absf(actual_color.r - original_color.r) < 0.004 and absf(actual_color.g - original_color.g) < 0.004,
				"authored foliage tint retained in instance data")
			var original_points: PackedVector3Array = canopies[i].mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
			var unit_points: PackedVector3Array = forest_batch.multimesh.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
			_check(original_points.size() == unit_points.size(), "all foliage segments retained")
			var pose := forest_batch.global_transform * forest_batch.multimesh.get_instance_transform(i)
			for vertex in original_points.size():
				_check((pose * unit_points[vertex]).distance_to(canopies[i].global_transform * original_points[vertex]) < 0.00002,
					"varied foliage geometry retained in world space")
	else:
		_check(false, "colored foliage MultiMesh exists")
	var kit := Node3D.new()
	root.add_child(kit)
	var fixed := Node3D.new()
	var live := Node3D.new()
	kit.add_child(fixed)
	kit.add_child(live)
	for i in 3:
		geometry.add_box_to("Support", Vector3.ONE, Vector3(i, 0, 0), finish, fixed)
		geometry.add_box_to("Moving", Vector3.ONE, Vector3(i, 0, 0), finish, live)
	var fixed_roots: Array[Node3D] = [fixed]
	var kit_result := batch.build_kit(kit, fixed_roots)
	_check(kit_result.replaced_sources == 3, "only supplied static native owners batch")
	for source in live.get_children():
		_check(source.layers == 1, "dynamic native subtree never enters static batch")
	print("SCRAPERX_STATIC_BATCH_TEST failures=%d" % _failures)
	quit(0 if _failures == 0 else 1)


func _vertices(sources: Array) -> Array:
	var result: Array = []
	for source in sources:
		var arrays: Array = source.mesh.surface_get_arrays(0)
		var positions: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var uvs: PackedVector2Array = arrays[Mesh.ARRAY_TEX_UV]
		var normals: PackedVector3Array = arrays[Mesh.ARRAY_NORMAL]
		var normal_basis: Basis = source.global_transform.basis.inverse().transposed()
		var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
		for index in indices:
			result.append([source.global_transform * positions[index], uvs[index],
				(normal_basis * normals[index]).normalized()])
	return result


func _same_vertices(expected: Array, actual: Array) -> bool:
	if expected.size() != actual.size():
		return false
	for i in expected.size():
		if not (expected[i][0] as Vector3).is_equal_approx(actual[i][0]) \
				or not (expected[i][1] as Vector2).is_equal_approx(actual[i][1]):
			return false
		if (expected[i][2] as Vector3).distance_to(actual[i][2]) > 0.0002:
			return false
	return true
