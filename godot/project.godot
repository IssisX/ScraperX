; Engine configuration file.
; ScraperX WO-004..WO-006: Fold-native stage, industrial identity, coupled machine.

config_version=5

[application]

config/name="ScraperX"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

; Galaxy Z Fold 6 inner display: 2160x1856, 20.9:18, a near-square canvas.
; The unfolded panel is the intended stage; the cover screen is the fallback.
window/size/viewport_width=2160
window/size/viewport_height=1856
window/size/window_width_override=1296
window/size/window_height_override=1114
; "expand" grows the viewport into whatever bounds the device actually gives us
; instead of letterboxing the design resolution into a phone-safe rectangle.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true
; Read once at startup on Android (Godot.kt onGodotMainLoopStarted); the
; in-game GYRO AIM setting decides whether the rate is used.
sensors/enable_gyroscope=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
environment/defaults/default_clear_color=Color(0.055, 0.055, 0.058, 1)
