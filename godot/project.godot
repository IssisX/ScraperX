; Engine configuration file.
; ScraperX CP-003: Fold-open exterior approach + native hopper matter transfer.

config_version=5

[application]

config/name="ScraperX"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1080
window/size/viewport_height=928
window/size/window_width_override=1080
window/size/window_height_override=928
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
