[configuration]

entry_symbol = "scraperx_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.editor.x86_64 = "res://addons/scraperx_native/bin/linux/libscraperx_native.so"
linux.debug.x86_64 = "res://addons/scraperx_native/bin/linux/libscraperx_native.so"
linux.release.x86_64 = "res://addons/scraperx_native/bin/linux/libscraperx_native.so"
android.debug.arm64 = "res://addons/scraperx_native/bin/android/arm64/libscraperx_native.so"
android.release.arm64 = "res://addons/scraperx_native/bin/android/arm64/libscraperx_native.so"
